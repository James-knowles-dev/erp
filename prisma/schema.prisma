// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Managed internally by @shopify/shopify-app-session-storage-prisma for OAuth session/token
// lifecycle. accessToken here is plaintext, per the library's default behavior -- this is a
// known gap against the "encrypted at rest" requirement in erp-connector-dev-spec.md §9; the
// separate Shop model below is our own app-level record and does store an encrypted token.
// Revisit a custom encrypting SessionStorage adapter before this handles real merchant data.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Matches the `shops` table in erp-connector-dev-spec.md §5.
model Shop {
  id                   String   @id @default(uuid())
  shopifyDomain        String   @unique @map("shopify_domain")
  accessTokenEncrypted String   @map("access_token_encrypted")
  installedAt          DateTime @map("installed_at")
  planTier             String   @map("plan_tier")
  // Added building Milestone 8. Neither spec describes how an agency actually gets linked to a
  // client shop in the first place (the dev spec's §6 API list assumes a link already exists) --
  // a merchant-generated, single-use invite code the merchant shares with their agency is a
  // reasonable filled-in gap: it means linking always requires the merchant's explicit action,
  // not just an agency guessing/entering a shop domain.
  agencyInviteCode       String?   @unique @map("agency_invite_code")
  agencyInviteCodeUsedAt DateTime? @map("agency_invite_code_used_at")

  erpConnections    ErpConnection[]
  agencyClientLinks AgencyClientLink[]

  @@map("shops")
}

// Matches `erp_connections` in erp-connector-dev-spec.md §5. v1 assumes one active connection
// per shop (see that section's comment), so no uniqueness constraint is added beyond the FK --
// enforcing "one active" is application logic, not a schema constraint, since a shop legitimately
// has multiple rows here across a connect -> disconnect -> reconnect lifecycle.
model ErpConnection {
  id                    String    @id @default(uuid())
  shopId                String    @map("shop_id")
  shop                  Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  erpType               String    @map("erp_type") // 'netsuite' | 'acumatica' | 'business_central' | 'sage_intacct' | 'sage_300' | 'brightpearl'
  environment           String // 'sandbox' | 'production'
  // Nullable, unlike the NOT NULL in the original erp-connector-dev-spec.md §5 SQL -- found
  // while building the wizard (Milestone 2): a connection legitimately exists in 'pending'
  // status (step 1, ERP picked) before any credentials are collected (step 2).
  credentialsEncrypted  String?   @map("credentials_encrypted")
  status                String // 'pending' | 'active' | 'error' | 'disabled'
  connectedAt           DateTime? @map("connected_at")
  lastSuccessfulSyncAt  DateTime? @map("last_successful_sync_at")
  // Both added building Milestone 3 -- the dev spec's API list (§6) implies this state exists
  // (PUT .../backfill-window, POST .../activate) but the original §5 SQL had no columns for it.
  // 'active' status means OAuth succeeded (Milestone 2); wentLiveAt is wizard step 8 specifically
  // -- webhooks are received and queued regardless, but the sync worker only pushes to the ERP
  // once this is set, matching "free sandbox/dry-run usage" until go-live (product spec §9).
  backfillWindow String?   @map("backfill_window") // 'none' | '30d' | '90d' | custom ISO range
  wentLiveAt     DateTime? @map("went_live_at")
  // Added building Milestone 6's extensibility hooks (product spec §7.7). Hashed like a
  // password, not encrypted -- we only ever need to verify a presented key against this, never
  // read the real value back out, so a one-way hash is the right primitive, not reversible
  // encryption. The plaintext key is shown to the merchant exactly once, at generation time.
  apiKeyHash String? @unique @map("api_key_hash")
  // Added building Milestone 7 (dev spec §14, "Parallel-run mode"): distinct from wentLiveAt --
  // a merchant migrating off an existing connector can start shadow-syncing (orders are received
  // and transformed, but never actually pushed to the ERP) before committing to cutover. Set
  // without wentLiveAt: shadow mode. Both set: live. Neither: nothing syncs at all.
  shadowModeStartedAt DateTime? @map("shadow_mode_started_at")

  fieldMappings          FieldMapping[]
  edgeCaseRules          EdgeCaseRule[]
  syncJobs               SyncJob[]
  reconciliationRecords  ReconciliationRecord[]
  webhookSubscriptions   WebhookSubscription[]
  activityLogs           ActivityLog[]

  @@map("erp_connections")
}

// Matches `field_mappings` in erp-connector-dev-spec.md §5.
model FieldMapping {
  id             String        @id @default(uuid())
  connectionId   String        @map("connection_id")
  connection     ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  shopifyField   String        @map("shopify_field")
  erpField       String        @map("erp_field")
  transformRule  String?       @map("transform_rule")
  isRequired     Boolean       @default(false) @map("is_required")

  @@index([connectionId])
  @@map("field_mappings")
}

// Matches `edge_case_rules` in erp-connector-dev-spec.md §5.
model EdgeCaseRule {
  id           String        @id @default(uuid())
  connectionId String        @map("connection_id")
  connection   ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  ruleKey      String        @map("rule_key") // e.g. 'backorder_behavior', 'guest_customer_handling'
  ruleValue    String        @map("rule_value")

  @@index([connectionId])
  @@map("edge_case_rules")
}

// Matches `sync_jobs` in erp-connector-dev-spec.md §5. The idempotency index below is the
// concrete mechanism behind §7's "keyed by Shopify resource ID + event type" -- a webhook
// redelivery for work already queued/processing is a no-op (see enqueueSyncJob() in
// app/sync/queue.server.ts), but a genuinely new event for the same resource (e.g. orders/updated
// after orders/create already succeeded) is not blocked, since only non-terminal jobs count.
//
// contentFingerprint (fix pass, erp-connector-fixes-spec.md F4): the index above only caught
// redeliveries of a still in-flight job -- once a job reached a terminal status, a redelivered
// webhook created a brand-new row and pushed to the ERP again. The unique constraint below closes
// that gap at the DB level (not just app-level check-then-act): a redelivery with an identical
// fingerprint for the same resource now fails on insert instead of silently duplicating, while a
// genuinely new event for the same resource (different fingerprint -- status changed, line items
// changed) is still allowed through. Nullable because non-order entity types don't compute one
// yet (see queue.server.ts) -- Postgres treats multiple NULLs as distinct, so this constraint
// doesn't protect those until they do.
model SyncJob {
  id                  String    @id @default(uuid())
  connectionId        String    @map("connection_id")
  connection          ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entityType          String    @map("entity_type") // 'order' | 'refund' | 'inventory' | 'customer' | 'product'
  direction           String // 'shopify_to_erp' | 'erp_to_shopify'
  shopifyReferenceId  String?   @map("shopify_reference_id")
  erpDocumentRef       String?   @map("erp_document_ref")
  status              String // 'queued' | 'processing' | 'success' | 'failed' | 'dead_letter'
  attempts            Int       @default(0)
  lastError           String?   @map("last_error")
  payload             Json?
  contentFingerprint  String?   @map("content_fingerprint")
  createdAt           DateTime  @default(now()) @map("created_at")
  completedAt         DateTime? @map("completed_at")
  // Added building Milestone 7: 'live' pushes to the ERP as normal; 'shadow' runs the same
  // transform/validation but never calls the adapter's push methods (dev spec §14's parallel-run
  // mode) -- set once at enqueue time from the connection's state, so the worker doesn't need to
  // re-derive it and a job's behavior can't change mid-flight if the connection's mode changes
  // while it's queued.
  mode                String    @default("live")

  @@index([connectionId, entityType, shopifyReferenceId, status])
  @@unique([connectionId, entityType, shopifyReferenceId, contentFingerprint], map: "sync_jobs_dedup_fingerprint_key")
  @@map("sync_jobs")
}

// Matches `reconciliation_records` in erp-connector-dev-spec.md §5.
model ReconciliationRecord {
  id                 String    @id @default(uuid())
  connectionId       String    @map("connection_id")
  connection         ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  shopifyOrderId     String    @map("shopify_order_id")
  shopifyTotal       Decimal?  @map("shopify_total")
  erpTotal           Decimal?  @map("erp_total")
  status             String // 'matched' | 'discrepancy' | 'pending'
  discrepancyReason  String?   @map("discrepancy_reason")
  checkedAt          DateTime  @default(now()) @map("checked_at")

  @@index([connectionId, status])
  @@map("reconciliation_records")
}

// Matches `activity_log` in erp-connector-dev-spec.md §5.
model ActivityLog {
  id           String        @id @default(uuid())
  connectionId String        @map("connection_id")
  connection   ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  eventType    String        @map("event_type")
  message      String
  severity     String // 'info' | 'warning' | 'error'
  occurredAt   DateTime      @default(now()) @map("occurred_at")
  // Added for GDPR data-request staging (erp-connector-fixes-spec.md F1, hardening pass
  // 2026-08-11): structured payload for entries that carry customer PII (e.g. gdpr_data_request's
  // export dump), kept separate from `message` so a later customers/redact request can find and
  // scrub the PII fields precisely instead of doing substring surgery on free text. Null for the
  // vast majority of log entries, which have no PII to carry.
  metadata Json? @map("metadata")

  @@index([connectionId, occurredAt])
  @@map("activity_log")
}

// Not in the original dev spec's §5 schema -- added building Milestone 6's extensibility hooks
// (product spec §7.7): "expose events... that an agency's own script or middleware can subscribe
// to." eventTypes is a comma-separated list (order_received | order_synced | sync_failed) rather
// than a normalized join table, matching the simplicity of edge_case_rules' own rule_key/
// rule_value pattern elsewhere in this schema.
model WebhookSubscription {
  id             String        @id @default(uuid())
  connectionId   String        @map("connection_id")
  connection     ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  url            String
  eventTypes     String        @map("event_types")
  secretEncrypted String       @map("secret_encrypted") // HMAC-signs outgoing deliveries
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([connectionId])
  @@map("webhook_subscriptions")
}

// --- Milestone 8: agency layer (product spec §7.8) ---
// Agencies aren't Shopify shops, so this whole layer needs its own auth (see AgencyUser) rather
// than reusing Shopify session auth the way every route so far has.

// Matches `agencies` in erp-connector-dev-spec.md §5.
model Agency {
  id             String   @id @default(uuid())
  name           String
  brandingConfig Json?    @map("branding_config") // logo url, colors for white-label reports
  createdAt      DateTime @default(now()) @map("created_at")

  users            AgencyUser[]
  clientLinks      AgencyClientLink[]
  mappingTemplates MappingTemplate[]

  @@map("agencies")
}

// Not in the original dev spec's §5 schema -- added while fixing spec gaps before Milestone 0
// (erp-connector-spec.md §7.8 promises "agency staff get scoped access to client instances," but
// the original schema only linked the agency as a whole to a client, with nowhere to represent
// individual staff members or their own credentials).
model AgencyUser {
  id           String   @id @default(uuid())
  agencyId     String   @map("agency_id")
  agency       Agency   @relation(fields: [agencyId], references: [id])
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String // 'owner' | 'admin' | 'staff' -- 'owner'/'admin' see every linked client;
                       // 'staff' is scoped via AgencyUserClientAccess
  createdAt    DateTime @default(now()) @map("created_at")

  clientAccess AgencyUserClientAccess[]

  @@map("agency_users")
}

// Matches `agency_client_links` in erp-connector-dev-spec.md §5.
model AgencyClientLink {
  id       String @id @default(uuid())
  agencyId String @map("agency_id")
  agency   Agency @relation(fields: [agencyId], references: [id])
  shopId   String @unique @map("shop_id") // one agency per shop (erp-connector-fixes-spec.md F14)
                                           // -- previously enforced only by an application-level
                                           // findFirst in redeemInviteCode(), a TOCTOU race on
                                           // concurrent invite-code redemptions.
  shop     Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  role     String // 'admin' | 'viewer' -- the agency's own access level on this client, unrelated
                  // to which staff member is acting (see AgencyUser.role for that)

  userAccess AgencyUserClientAccess[]

  @@map("agency_client_links")
}

// Per-client scoping for 'staff'-role AgencyUsers -- absence of a row means no access for that
// user to that client. 'owner'/'admin' role users bypass this table entirely (see
// requireAgencyAccess in app/utils/agencyAuth.server.ts).
model AgencyUserClientAccess {
  id                 String           @id @default(uuid())
  agencyUserId       String           @map("agency_user_id")
  agencyUser         AgencyUser       @relation(fields: [agencyUserId], references: [id])
  agencyClientLinkId String           @map("agency_client_link_id")
  agencyClientLink   AgencyClientLink @relation(fields: [agencyClientLinkId], references: [id], onDelete: Cascade)

  @@unique([agencyUserId, agencyClientLinkId])
  @@map("agency_user_client_access")
}

// Matches `mapping_templates` in erp-connector-dev-spec.md §5.
model MappingTemplate {
  id                      String   @id @default(uuid())
  agencyId                String   @map("agency_id")
  agency                  Agency   @relation(fields: [agencyId], references: [id])
  erpType                 String   @map("erp_type")
  template                Json // FieldMapping[] JSON, same shape field_mappings rows collapse into
  createdFromConnectionId String?  @map("created_from_connection_id")
  createdAt               DateTime @default(now()) @map("created_at")

  @@map("mapping_templates")
}
