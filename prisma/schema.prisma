// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Managed internally by @shopify/shopify-app-session-storage-prisma for OAuth session/token
// lifecycle. accessToken here is plaintext, per the library's default behavior -- this is a
// known gap against the "encrypted at rest" requirement in erp-connector-dev-spec.md §9; the
// separate Shop model below is our own app-level record and does store an encrypted token.
// Revisit a custom encrypting SessionStorage adapter before this handles real merchant data.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Matches the `shops` table in erp-connector-dev-spec.md §5.
model Shop {
  id                   String   @id @default(uuid())
  shopifyDomain        String   @unique @map("shopify_domain")
  accessTokenEncrypted String   @map("access_token_encrypted")
  installedAt          DateTime @map("installed_at")
  planTier             String   @map("plan_tier")

  erpConnections ErpConnection[]

  @@map("shops")
}

// Matches `erp_connections` in erp-connector-dev-spec.md §5. v1 assumes one active connection
// per shop (see that section's comment), so no uniqueness constraint is added beyond the FK --
// enforcing "one active" is application logic, not a schema constraint, since a shop legitimately
// has multiple rows here across a connect -> disconnect -> reconnect lifecycle.
model ErpConnection {
  id                    String    @id @default(uuid())
  shopId                String    @map("shop_id")
  shop                  Shop      @relation(fields: [shopId], references: [id])
  erpType               String    @map("erp_type") // 'netsuite' | 'acumatica' | 'business_central' | 'sage_intacct' | 'sage_300' | 'brightpearl'
  environment           String // 'sandbox' | 'production'
  // Nullable, unlike the NOT NULL in the original erp-connector-dev-spec.md §5 SQL -- found
  // while building the wizard (Milestone 2): a connection legitimately exists in 'pending'
  // status (step 1, ERP picked) before any credentials are collected (step 2).
  credentialsEncrypted  String?   @map("credentials_encrypted")
  status                String // 'pending' | 'active' | 'error' | 'disabled'
  connectedAt           DateTime? @map("connected_at")
  lastSuccessfulSyncAt  DateTime? @map("last_successful_sync_at")
  // Both added building Milestone 3 -- the dev spec's API list (§6) implies this state exists
  // (PUT .../backfill-window, POST .../activate) but the original §5 SQL had no columns for it.
  // 'active' status means OAuth succeeded (Milestone 2); wentLiveAt is wizard step 8 specifically
  // -- webhooks are received and queued regardless, but the sync worker only pushes to the ERP
  // once this is set, matching "free sandbox/dry-run usage" until go-live (product spec §9).
  backfillWindow String?   @map("backfill_window") // 'none' | '30d' | '90d' | custom ISO range
  wentLiveAt     DateTime? @map("went_live_at")
  // Added building Milestone 6's extensibility hooks (product spec §7.7). Hashed like a
  // password, not encrypted -- we only ever need to verify a presented key against this, never
  // read the real value back out, so a one-way hash is the right primitive, not reversible
  // encryption. The plaintext key is shown to the merchant exactly once, at generation time.
  apiKeyHash String? @unique @map("api_key_hash")

  fieldMappings          FieldMapping[]
  edgeCaseRules          EdgeCaseRule[]
  syncJobs               SyncJob[]
  reconciliationRecords  ReconciliationRecord[]
  webhookSubscriptions   WebhookSubscription[]
  activityLogs           ActivityLog[]

  @@map("erp_connections")
}

// Matches `field_mappings` in erp-connector-dev-spec.md §5.
model FieldMapping {
  id             String        @id @default(uuid())
  connectionId   String        @map("connection_id")
  connection     ErpConnection @relation(fields: [connectionId], references: [id])
  shopifyField   String        @map("shopify_field")
  erpField       String        @map("erp_field")
  transformRule  String?       @map("transform_rule")
  isRequired     Boolean       @default(false) @map("is_required")

  @@map("field_mappings")
}

// Matches `edge_case_rules` in erp-connector-dev-spec.md §5.
model EdgeCaseRule {
  id           String        @id @default(uuid())
  connectionId String        @map("connection_id")
  connection   ErpConnection @relation(fields: [connectionId], references: [id])
  ruleKey      String        @map("rule_key") // e.g. 'backorder_behavior', 'guest_customer_handling'
  ruleValue    String        @map("rule_value")

  @@map("edge_case_rules")
}

// Matches `sync_jobs` in erp-connector-dev-spec.md §5. The idempotency index below is the
// concrete mechanism behind §7's "keyed by Shopify resource ID + event type" -- a webhook
// redelivery for work already queued/processing is a no-op (see enqueueSyncJob() in
// app/sync/queue.server.ts), but a genuinely new event for the same resource (e.g. orders/updated
// after orders/create already succeeded) is not blocked, since only non-terminal jobs count.
model SyncJob {
  id                  String    @id @default(uuid())
  connectionId        String    @map("connection_id")
  connection          ErpConnection @relation(fields: [connectionId], references: [id])
  entityType          String    @map("entity_type") // 'order' | 'refund' | 'inventory' | 'customer' | 'product'
  direction           String // 'shopify_to_erp' | 'erp_to_shopify'
  shopifyReferenceId  String?   @map("shopify_reference_id")
  erpDocumentRef       String?   @map("erp_document_ref")
  status              String // 'queued' | 'processing' | 'success' | 'failed' | 'dead_letter'
  attempts            Int       @default(0)
  lastError           String?   @map("last_error")
  payload             Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  completedAt         DateTime? @map("completed_at")

  @@index([connectionId, entityType, shopifyReferenceId, status])
  @@map("sync_jobs")
}

// Matches `reconciliation_records` in erp-connector-dev-spec.md §5.
model ReconciliationRecord {
  id                 String    @id @default(uuid())
  connectionId       String    @map("connection_id")
  connection         ErpConnection @relation(fields: [connectionId], references: [id])
  shopifyOrderId     String    @map("shopify_order_id")
  shopifyTotal       Decimal?  @map("shopify_total")
  erpTotal           Decimal?  @map("erp_total")
  status             String // 'matched' | 'discrepancy' | 'pending'
  discrepancyReason  String?   @map("discrepancy_reason")
  checkedAt          DateTime  @default(now()) @map("checked_at")

  @@index([connectionId, status])
  @@map("reconciliation_records")
}

// Matches `activity_log` in erp-connector-dev-spec.md §5.
model ActivityLog {
  id           String        @id @default(uuid())
  connectionId String        @map("connection_id")
  connection   ErpConnection @relation(fields: [connectionId], references: [id])
  eventType    String        @map("event_type")
  message      String
  severity     String // 'info' | 'warning' | 'error'
  occurredAt   DateTime      @default(now()) @map("occurred_at")

  @@index([connectionId, occurredAt])
  @@map("activity_log")
}

// Not in the original dev spec's §5 schema -- added building Milestone 6's extensibility hooks
// (product spec §7.7): "expose events... that an agency's own script or middleware can subscribe
// to." eventTypes is a comma-separated list (order_received | order_synced | sync_failed) rather
// than a normalized join table, matching the simplicity of edge_case_rules' own rule_key/
// rule_value pattern elsewhere in this schema.
model WebhookSubscription {
  id             String        @id @default(uuid())
  connectionId   String        @map("connection_id")
  connection     ErpConnection @relation(fields: [connectionId], references: [id])
  url            String
  eventTypes     String        @map("event_types")
  secretEncrypted String       @map("secret_encrypted") // HMAC-signs outgoing deliveries
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([connectionId])
  @@map("webhook_subscriptions")
}
