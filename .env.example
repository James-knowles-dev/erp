# Copy to .env and fill in. Never commit the real .env (already gitignored).

# --- Shopify Partner app (from the app's page in the Partner Dashboard) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated Admin API scopes -- see shopify.app.toml.
SCOPES=
# The app's public URL. In local dev, `shopify app dev` sets this automatically via a tunnel;
# only needs to be set explicitly for deployed environments (Railway, etc).
SHOPIFY_APP_URL=
# Only needed if serving the embedded app from a custom domain instead of *.myshopify.com.
SHOP_CUSTOM_DOMAIN=

# --- Database (Railway Postgres plugin's connection string once provisioned) ---
DATABASE_URL=

# --- Job queue (Railway Redis plugin's connection string) ---
# Required at server startup as of Milestone 3, not optional -- the sync worker boots eagerly
# (see app/sync/worker.server.ts) and the process crashes immediately without this set.
REDIS_URL=

# --- Encryption (see erp-connector-build-plan.md decision D2) ---
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=
# --- Key rotation (erp-connector-fixes-spec.md F12) ---
# Both optional -- omit both and only ENCRYPTION_MASTER_KEY (version 1) is used, same as before
# rotation support existed. To rotate: generate a new key into ENCRYPTION_MASTER_KEY_V2 (or the
# next unused version number), deploy it alongside the still-present older *_V{n} vars, then bump
# ENCRYPTION_KEY_VERSION so new encryptions use it -- old ciphertext keeps decrypting under its own
# embedded version. Run reencryptCredentials.server.ts's reencryptStaleCredentials() afterward to
# actually move existing rows onto the new version.
# ENCRYPTION_MASTER_KEY_V2=
# ENCRYPTION_KEY_VERSION=1

# --- Billing (see app/utils/billing.server.ts) ---
# Defaults to test mode (safe) if unset. Only set to "false" once real pricing is live.
SHOPIFY_BILLING_TEST_MODE=true

# --- Internal monitoring (app/routes/internal.status.tsx) ---
# Gates /internal/status (vendor-side dashboard, not merchant-facing). Without this set, that
# route returns 503 rather than silently allowing unauthenticated access.
# Generate with: openssl rand -hex 24
INTERNAL_DASHBOARD_TOKEN=

# --- Agency layer (app/utils/agencyAuth.server.ts) ---
# Signs the /agency/* cookie session. Required in production (server throws at boot if unset);
# falls back to an insecure dev default outside production so local dev doesn't need it.
# Generate with: openssl rand -hex 32
AGENCY_SESSION_SECRET=

# --- Brightpearl adapter (app/adapters/brightpearl/) ---
# Unlike NetSuite/Acumatica/Business Central, these belong to *this app* (registered once in
# Brightpearl's Developer Area), not to each merchant's own instance -- a merchant only enters
# their account code in the wizard. Required for any merchant to connect a Brightpearl account.
BRIGHTPEARL_CLIENT_ID=
BRIGHTPEARL_CLIENT_SECRET=

# --- Sage Intacct adapter (app/adapters/sageintacct/) ---
# Our Sender ID/password from Sage's Partner Program (developer.intacct.com) -- shared across
# every merchant's connection, like the Brightpearl client credentials above. Each merchant
# separately authorizes this Sender ID for Web Services access inside their own Intacct company.
SAGE_INTACCT_SENDER_ID=
SAGE_INTACCT_SENDER_PASSWORD=
